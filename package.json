{
  "name": "@devxcrew/framework",
  "version": "0.1.10",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/modules/api-client/api-client.provider.d.ts",
      "default": "./dist/modules/api-client/api-client.provider.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=26.10.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devxcrew/framework.git"
  },
  "devDependencies": {
    "@devxcrew/tools": "0.1.8",
    "@types/node": "^26.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "scripts": {
    "github:now": "devxcrew-tools github:now",
    "version:update": "devxcrew-tools version:bump",
    "fix:line-endings": "devxcrew-tools lines:fix",
    "check:versions": "devxcrew-tools check:versions",
    "version:show": "devxcrew-tools version:show",
    "version:bump": "devxcrew-tools version:bump",
    "changelog:append": "devxcrew-tools changelog:append",
    "changelog:show": "devxcrew-tools changelog:show",
    "tools:lines:fix": "devxcrew-tools lines:fix",
    "lines:check": "devxcrew-tools lines:check",
    "tools:check": "devxcrew-tools dependencies:order && devxcrew-tools check:versions && devxcrew-tools lines:check",
    "check": "npm run tools:check && npm test",
    "mcp:connect": "node agent/connect.mjs",
    "mcp:verify": "node agent/connect.mjs --strict",
    "version-bump": "devxcrew-tools version:bump",
    "prepublishOnly": "npm run release:check",
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "release:check": "npm run check && npm run build && npm pack --dry-run --ignore-scripts",
    "test": "npm run build && node --test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
